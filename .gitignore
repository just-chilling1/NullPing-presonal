# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
._*
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.example

# large media files
public/*.mp4

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# accelerator seed temp artifacts
scripts/.accelerator-*

# training video pipeline temp artifacts
scripts/.recurring-*

# training video system — skip deps and rendered media
training-video-system/**/node_modules
training-video-system/**/videos
training-video-system/**/voiceovers
training-video-system/**/screenshots
training-video-system/**/Audio
training-video-system/**/audio
training-video-system/**/remotion/out
training-video-system/**/remotion/public/*.mp3
training-video-system/**/*.mp4
