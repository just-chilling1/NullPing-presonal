NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# App domain — where this software is hosted (auth redirects, password-reset emails).
# Local: http://localhost:3000  |  Production: https://yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Software name — shown in auth UI, onboarding, browser title (canonical: src/config/brand.config.ts)
# NEXT_PUBLIC_PRODUCT_NAME=NullPing Cash

# Local preview only — skip login + onboarding redirects
# DEV_BYPASS_AUTH=true

# Optional: signup webhook (Make.com, etc.)
WEBHOOK_SIGNUP_URL=

# Support API — required so Contact Support sends in-app (Freshdesk, then Resend).
# Without these keys the form cannot deliver the message.
# FRESHDESK_DOMAIN=neoaifreshdesk
# FRESHDESK_API_KEY=your_freshdesk_api_key
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM_EMAIL=NullPing Cash <support@reliteagency.com>

# Feature module env (only when core-workflow is enabled)
# RAPIDAPI_KEY=
# RAPIDAPI_HOST_REDDIT=
# RAPIDAPI_HOST_YOUTUBE=
# RAPIDAPI_HOST_CHATGPT=
# SCRAPERAPI_KEY=
# PROJECT_REF=

# Supabase auth setup script
# SUPABASE_ACCESS_TOKEN=

# Admin account — promo link editor (src/app/admin)
# ADMIN_EMAIL=admin@gmail.com
# ADMIN_PASSWORD=your_secure_password

# --- blog-builder (generation pipeline) ---
# Required for scrape cache, click tracking, dev bypass, premium template seeding
# SUPABASE_SERVICE_ROLE_KEY=

# Premium recurring stream — one-time 100 article seed (scripts/seed-recurring-stream.ts)
# RECURRING_SEED_SECRET=       # header for PUT /api/premium/recurring-stream/articles

# Unlimited (accelerator) — one-time 200 sales-page seed (npm run seed:accelerator)
# TEMPLATE_OWNER_ID=           # Supabase Auth user UUID that owns template sites
# ACCELERATOR_SEED_SECRET=     # header for POST /api/premium/accelerator/seed
# PIXABAY_API_KEY=             # recommended so ~25% niche images resolve from stock photos

# AI text generation (RapidAPI GPT — same provider as clickcloneprofits)
# RAPIDAPI_KEY=
# RAPIDAPI_HOST=chatgpt-42.p.rapidapi.com
# RAPIDAPI_HOST_CHATGPT=chatgpt-42.p.rapidapi.com  # alias for RAPIDAPI_HOST

# Image resolution (blog + NullPing pins/money-page heroes)
# Pipeline: scrape affiliate page (og:image / ranked <img>) → Pixabay stock → Picsum
# IMAGE_RESOLUTION_CONCURRENCY=4
# PIXABAY_API_KEY=              # recommended for stock fallbacks when scrape finds no image
# RAPIDAPI_IMAGE_HOST=ultra-fast-nano-banana-22.p.rapidapi.com

# Affiliate offer page scraping — JS-rendered pages need one of these
# SCRAPER_API_KEY=
# SCRAPERAPI_KEY=

# Optional
# TEXT_GENERATION_CONCURRENCY=3
